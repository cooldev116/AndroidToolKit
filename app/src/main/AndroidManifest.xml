<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidToolKit"
        tools:replace="android:allowBackup"
        tools:targetApi="31">

        <!-- NetRepository.buildApi 读取的 API 根地址，值由 Gradle manifestPlaceholders.API_URL 注入 -->
        <meta-data
            android:name="API_URL"
            android:value="${API_URL}" />
        <!-- 公共请求头 channel，值由 Gradle manifestPlaceholders.CHANNEL 注入 -->
        <meta-data
            android:name="CHANNEL"
            android:value="${CHANNEL}" />

        <activity
            android:name=".ui.activity.SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AndroidToolKit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.activity.SplashBackendActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.AndroidToolKit" />
        <activity android:name=".ui.activity.MainActivity" />
        <activity android:name=".ui.activity.AdTestActivity" />
    </application>

</manifest>