<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--    标题栏自定义属性-->
    <declare-styleable name="AppBarView">
        <!--        标题-->
        <attr name="app_bar_title" format="string" />
        <!--        标题颜色-->
        <attr name="app_bar_title_color" format="color" />
        <!--        标题颜色-->
        <attr name="app_bar_title_size" format="dimension" />
        <!--        是否包含状态栏-->
        <attr name="app_bar_is_status_bar" format="boolean" />
        <!--        返回图标-->
        <attr name="app_bar_back_icon" format="reference" />
        <!--        右侧文字-->
        <attr name="app_bar_right_text" format="string" />
        <!--        右侧文字颜色-->
        <attr name="app_bar_right_text_color" format="color" />
        <!--        右侧文字大小-->
        <attr name="app_bar_right_text_size" format="dimension" />
        <!--        右侧图标-->
        <attr name="app_bar_right_icon" format="reference" />
        <!--        右侧自定义布局-->
        <attr name="app_bar_right_custom_layout" format="reference" />
    </declare-styleable>

    <!-- TextView 可点击链接：主题可挂 style，统一默认颜色 -->
    <attr name="textLinkBuilderStyle" format="reference" />

    <declare-styleable name="TextLinkBuilder">
        <attr name="defaultLinkColor" format="color" />
        <attr name="defaultTextColorOfHighlightedLink" format="color" />
    </declare-styleable>
</resources>